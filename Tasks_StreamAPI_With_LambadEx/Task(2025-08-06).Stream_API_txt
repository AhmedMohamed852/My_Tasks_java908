Task 3 : ==> Check if any number is divisible by 5 in a list.

   List<Integer> numbers = Arrays.asList(10, 5, 3, 7, 2, 10, 5, 8, 9, 0, -3, 4);
   System.out.println(numbers.stream().anyMatch(n -> n !=0 && n % 5 == 0));
   System.out.println(numbers.stream().filter(n -> n % 5 == 0 && n > 0).collect(Collectors.toList()));

